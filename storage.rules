rules_version = '2';

// Firebase Storage Security Rules for SSBMax
service firebase.storage {
  match /b/{bucket}/o {
    
    // PPDT test images - Authenticated read, no client write
    match /ppdt_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // TAT test images - Authenticated read, no client write
    match /tat_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // GPE test images - Authenticated read, no client write
    match /gpe_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // User uploads and candidate submissions - AUTHENTICATED & OWNER ONLY (max 10MB & valid MIME types)
    match /user_uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && 
                      request.auth.uid == userId && 
                      request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf|audio/.*');
    }
    
    // Default: Deny all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
