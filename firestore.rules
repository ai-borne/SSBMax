rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user is an assessor
    function isAssessor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ASSESSOR';
    }
    
    // Check if user is a student
    function isStudent() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'STUDENT';
    }
    
    // Check if user is assessor for a specific batch
    function isAssessorForBatch(batchId) {
      return isAuthenticated() &&
             isAssessor() &&
             exists(/databases/$(database)/documents/batches/$(batchId)) &&
             get(/databases/$(database)/documents/batches/$(batchId)).data.instructorId == request.auth.uid;
    }
    
    // ============================================
    // USER DATA - CRITICAL FOR PROFILE
    // ============================================
    
    match /users/{userId} {
      // Users can read their own data
      allow read: if isOwner(userId);
      
      // Users can create their own profile
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own profile (except privileged membership and role fields)
      allow update: if isOwner(userId) && 
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPaidMember', 'membershipPlan', 'paymentId', 'orderId']);
      
      // No one can delete user profiles
      allow delete: if false;
      
      // 🔥 THIS IS THE CRITICAL FIX FOR YOUR PROFILE ERROR
      // User data subcollection (for profile, settings, etc.)
      match /data/{document} {
        // Users can read/write their own data subcollection
        allow read, write: if isOwner(userId);
      }
      
      // Subscription usage tracking (server-side persistence)
      // Phase 5 (docs/plans/CrossPlatform_SSOT): the `recordTestUsage` callable Cloud
      // Function (functions/src/eligibility.js, Admin SDK) is now the sole writer of
      // usage_{month} docs -- Admin SDK bypasses these rules entirely, so clients have
      // no write path left at all. This closes the "clear app cache to reset quota"
      // bypass the old client-writable rules (a client could construct any counter
      // value satisfying the increment-by-one invariant) still nominally allowed.
      match /subscription/{document} {
        // Users can read their own subscription usage
        allow read: if isOwner(userId);

        // Only the recordTestUsage callable function (Admin SDK) may write.
        allow write: if false;
      }
      
      // User subscription data
      match /data/subscription {
        // Users can read their own subscription
        allow read: if isOwner(userId);
        
        // Only backend can write subscription data
        // (Payment processing updates subscription tier)
        allow write: if false;
      }
    }
    
    // ============================================
    // TEST CONTENT (Metadata only - not actual questions)
    // ============================================
    
    match /tests/{testId} {
      // All authenticated users can read test metadata
      allow read: if isAuthenticated();
      
      // No write access to test content for clients
      allow write: if false;
    }
    
    // ============================================
    // TEST QUESTIONS (Secure - Cloud-First Architecture)
    // ============================================
    
    match /test_questions/{testId} {
      // Students can ONLY read questions if they have an active test session
      // This prevents sideloading APKs from accessing questions
      allow read: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/test_sessions/$(request.auth.uid + '_' + testId)) &&
                     get(/databases/$(database)/documents/test_sessions/$(request.auth.uid + '_' + testId)).data.isActive == true &&
                     get(/databases/$(database)/documents/test_sessions/$(request.auth.uid + '_' + testId)).data.expiresAt > request.time.toMillis() &&
                                          get(/databases/$(database)/documents/test_sessions/$(request.auth.uid + '_' + testId)).data.status == 'ACTIVE';
      
      // No write access for clients
      allow write: if false;
    }
    
    // ============================================
    // TEST CONFIGURATIONS
    // ============================================
    
    match /test_configs/{testId} {
      // All authenticated users can read test configs
      allow read: if isAuthenticated();
      
      // No write access for clients
      allow write: if false;
    }
    
    // ============================================
    // TEST SESSIONS
    // ============================================
    
    match /test_sessions/{sessionId} {
      // Users can read their own test sessions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can create only an active session owned by themselves.
      //
      // startTime/expiresAt are deliberately NOT compared against request.time.toMillis():
      // they are client-clock values, and a device clock running even slightly ahead of the
      // server's would deny an otherwise-valid session. They are informational fields backing
      // the 2-hour countdown UI, not a security boundary -- ownership plus the shape checks
      // below are the actual guard.
      allow create: if isAuthenticated() &&
                       request.resource.id == request.auth.uid + '_' + request.resource.data.testId &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.isActive == true &&
                       request.resource.data.status == 'ACTIVE';

      // Identity and test configuration are immutable across any update. Two legal
      // transitions on the shared userId_testId doc:
      //   1. an active session going terminal (submit/abandon/expire);
      //   2. the owner starting a fresh attempt over their own prior session -- the client
      //      reuses the same doc id every time a test is retaken (see
      //      GitLiveTestSessionRepository's class doc), so createTestSession() always lands
      //      as a full-document replace on top of whatever is already there.
      //
      // (2) deliberately does NOT require the prior session to be terminal or past its
      // expiresAt. Requiring that is exactly what caused the "Cloud connection required" /
      // "Could not create a secure test session" incident: any exit path that misses
      // abandonTestSession (process death, or a load that fails after the session write)
      // leaves the doc stuck ACTIVE, and the owner is then locked out of their own test for
      // the full two hours behind a misleading connectivity error. Blocking the owner here
      // buys no security -- they already hold an ACTIVE session and can already read
      // test_questions with it, and the identical reset is reachable in two writes (abandon,
      // then re-create) which transition (1) permits unconditionally. Ownership,
      // userId/testId/testType immutability and the status whitelist are the real guards.
      //
      // (Note for future editors: request.time.toMillis() comparisons are NOT broken here.
      // An earlier fix removed them on that theory; a clause-by-clause emulator bisection
      // disproved it. They are omitted because startTime/expiresAt are client-clock values,
      // not because the operator misbehaves.)
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.testId == resource.data.testId &&
                       request.resource.data.testType == resource.data.testType &&
                       (
                         (resource.data.status == 'ACTIVE' &&
                          request.resource.data.isActive == false &&
                          request.resource.data.status in ['ABANDONED', 'SUBMITTED', 'EXPIRED'] &&
                          request.resource.data.startTime == resource.data.startTime &&
                          request.resource.data.expiresAt == resource.data.expiresAt) ||
                         (request.resource.data.isActive == true &&
                          request.resource.data.status == 'ACTIVE')
                       );
      
      // Sessions are retained as an audit trail; clients cannot delete them.
      allow delete: if false;
    }
    
    // ============================================
    // TEST SUBMISSIONS (Enhanced for AI + Assessor Grading)
    // ============================================
    
    match /submissions/{submissionId} {
      // Students can read their own submissions
      // Assessors can read submissions assigned to them or for their batches
      // NOTE: userId should always be at root level for all submission types
      allow read: if isAuthenticated() && 
                     (resource == null ||  // Allow reading if resource doesn't exist yet
                      resource.data.userId == request.auth.uid || 
                      resource.data.instructorId == request.auth.uid ||
                      (isAssessor() && resource.data.keys().hasAny(['batchId']) && 
                       get(/databases/$(database)/documents/batches/$(resource.data.batchId)).data.instructorId == request.auth.uid));
      
      // Students can create submissions
      // Must include required fields: userId, testType, submittedAt
      // Note: 'responses' can be at root level OR nested in 'data' field (depending on test type)
      // Interview submissions may have 'resultId' instead of responses/data
      // OIR (OIR Retake Seal, Phase 1+4): each attempt mints its own submission id, distinct from
      // the durable test_sessions id (docs/plans/OIR_Retake_Seal_Execution_Plan.md), so the
      // session doc to check is read off the submission's own nested `data.testResult.sessionId`
      // field (OIRSubmissionMappers.kt's real write shape) -- NOT `request.resource.id`, which is
      // now a random per-attempt id that never matches a test_sessions doc id.
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       (!request.resource.data.keys().hasAny(['testType']) ||
                        request.resource.data.testType != 'OIR' ||
                        (request.resource.data.keys().hasAny(['data']) &&
                         'testResult' in request.resource.data.data &&
                         'sessionId' in request.resource.data.data.testResult &&
                         exists(/databases/$(database)/documents/test_sessions/$(request.resource.data.data.testResult.sessionId)) &&
                         get(/databases/$(database)/documents/test_sessions/$(request.resource.data.data.testResult.sessionId)).data.userId == request.auth.uid &&
                         get(/databases/$(database)/documents/test_sessions/$(request.resource.data.data.testResult.sessionId)).data.testType == 'OIR')) &&
                       request.resource.data.keys().hasAll(['testType', 'submittedAt']) &&
                       (request.resource.data.keys().hasAny(['responses']) ||
                        request.resource.data.keys().hasAny(['data']) ||
                        request.resource.data.keys().hasAny(['resultId']));
      
      // Students can update their own IN_PROGRESS submissions for auto-save
      // Students can update status field for their own submissions (for background workers)
      // Assessors can update submissions for grading (any status)
      allow update: if isAuthenticated() &&
                       ((resource.data.userId == request.auth.uid && resource.data.status == 'IN_PROGRESS') ||
                        // Allow status and data.analysisStatus updates for background analysis workers
                        (resource.data.userId == request.auth.uid &&
                         resource.data.status in ['PENDING_ANALYSIS', 'ANALYZING', 'SUBMITTED_PENDING_REVIEW']) ||
                        (resource.data.instructorId == request.auth.uid) ||
                        (isAssessor() && resource.data.keys().hasAny(['batchId']) &&
                         get(/databases/$(database)/documents/batches/$(resource.data.batchId)).data.instructorId == request.auth.uid));
      
      // Students can delete their own DRAFT submissions only
      // Assessors cannot delete submissions (audit trail)
      allow delete: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid &&
                       resource.data.status == 'DRAFT';
    }
    
    // ============================================
    // ARCHIVED SUBMISSIONS
    // ============================================

    // Deny-all for clients. GitLiveSubmissionArchiveRepository (used by
    // app's ArchivalWorker) writes here, but it runs as a per-device
    // WorkManager job on the ordinary client SDK and collection-group-reads
    // ALL users' `submissions`, which the owner-scoped rule above already
    // blocks for anything but the current user's own docs -- so the
    // cross-user archival this worker is meant to perform is already
    // effectively broken today. Opening this collection to client writes
    // would fix that access pattern but would also let a compromised client
    // delete/archive other users' submissions -- a security regression, not
    // a fix. Tracked follow-up: move archival to a scheduled Cloud Function
    // (Tier 2, Admin SDK) instead of widening client rules. See docs/plans/
    // CrossPlatform_SSOT Phase 2 handoff.
    match /archived_submissions/{submissionId} {
      allow read, write: if false;
    }

    // ============================================
    // GTO RESULTS (Split Architecture like Interview)
    // ============================================
    
    match /gto_results/{resultId} {
      // Users can read/write their own GTO results (client-side AI analysis)
      allow read, write: if isAuthenticated() && 
                            (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    
    // ============================================
    // PPDT RESULTS (Split Architecture like GTO)
    // ============================================
    
    match /ppdt_results/{resultId} {
      // Users can read/write their own PPDT results (client-side AI analysis)
      allow read, write: if isAuthenticated() && 
                            (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // ============================================
    // PSYCH RESULTS (Split Architecture)
    // ============================================
    
    match /psych_results/{resultId} {
      // Users can read/write their own Psych results (client-side AI analysis)
      allow read, write: if isAuthenticated() && 
                            (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    
    // ============================================
    // AI GRADING RESULTS (Premium AI Feature)
    // ============================================
    
    match /ai_grading_results/{resultId} {
      // Students can read their own AI grading results
      // Results are linked to submissions via submissionId field
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // No client write access (AI backend service writes these)
      allow write: if false;
    }
    
    // ============================================
    // NOTIFICATIONS
    // ============================================
    
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // NOTIFICATION PREFERENCES
    // ============================================
    
    match /notificationPreferences/{userId} {
      // Users can read/write their own preferences
      allow read, write: if isOwner(userId);
    }
    
    // ============================================
    // FCM TOKENS
    // ============================================
    
    match /fcmTokens/{tokenId} {
      // Users can read their own tokens
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can create/update their own tokens
      allow create, update: if isAuthenticated() && 
                               request.resource.data.userId == request.auth.uid;
      
      // Users can delete their own tokens
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ============================================
    // USER PROGRESS
    // ============================================

    match /user_progress/{userId} {
      // Users can read/write their own progress
      allow read, write: if isOwner(userId);
    }

    // ============================================
    // BATCHES (SSB Marketplace)
    // ============================================
    
    match /batches/{batchId} {
      // All authenticated users can read batch info
      allow read: if isAuthenticated();
      
      // Only assessors can create/update batches
      allow create, update: if isAuthenticated() && 
                               request.resource.data.instructorId == request.auth.uid;
      
      // No delete
      allow delete: if false;
    }
    
    // ============================================
    // BATCH ENROLLMENTS
    // ============================================
    
    match /batchEnrollments/{enrollmentId} {
      // Users can read their own enrollments
      // Assessors can read enrollments for their batches
      allow read: if isAuthenticated() && 
                     (resource.data.studentId == request.auth.uid ||
                      (isAssessor() && 
                       get(/databases/$(database)/documents/batches/$(resource.data.batchId)).data.instructorId == request.auth.uid));
      
      // Students can create enrollments
      allow create: if isAuthenticated() && 
                       request.resource.data.studentId == request.auth.uid;
      
      // No update or delete
      allow update, delete: if false;
    }
    
    // ============================================
    // TOPIC CONTENT (Dynamic content from cloud)
    // ============================================
    
    match /topic_content/{topicId} {
      // All authenticated users can read topic content
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // STUDY PROGRESS (per-user, doc id `${userId}_${materialId}`)
    // ============================================

    match /study_progress/{progressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /study_sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================
    // STUDY MATERIALS (Structured content)
    // ============================================
    
    match /study_materials/{materialId} {
      // All authenticated users can read study materials
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // ============================================
    // CONTENT VERSIONS (Cache invalidation)
    // ============================================
    
    match /content_versions/{versionId} {
      // All authenticated users can read version info
      allow read: if isAuthenticated();
      
      // No client write access
      allow write: if false;
    }
    
    // ============================================
    // TEST CONTENT (Progressive Caching - ALL TESTS)
    // ============================================
    
    // OIR Test Content
    match /test_content/oir/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/oir/batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // WAT Test Content
    match /test_content/wat/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/wat/word_batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // SRT Test Content
    match /test_content/srt/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/srt/situation_batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // TAT Test Content
    match /test_content/tat/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/tat/image_batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // PPDT Test Content
    match /test_content/ppdt/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/ppdt/image_batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // GTO Test Content
    match /test_content/gto/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/gto/task_batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // GPE (Group Planning Exercise) Test Content
    match /test_content/gto/scenarios/gpe/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/gto/scenarios/gpe/batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Interview Test Content
    match /test_content/interview/meta/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    match /test_content/interview/question_batches/{batchId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ============================================
    // HEALTH CHECK (Firebase connectivity test)
    // ============================================
    
    match /health_check/{document} {
      // All authenticated users can read health check docs
      allow read: if isAuthenticated();
      
      // No client write access (created manually in Console)
      allow write: if false;
    }
    
    // ============================================
    // REMOTE KILL-SWITCH (Phase 8, Cross-Platform SSOT plan)
    // ============================================

    match /feature_flags/{document} {
      // Public read, unlike every other collection in this file: the version
      // gate this doc drives runs at app launch, before a user has signed
      // in (splash/login screens are themselves gated by it), so requiring
      // auth here would make the kill-switch unusable for exactly the users
      // who most need to see "update required."
      allow read: if true;
      allow write: if false;
    }

    // ============================================
    // INTERVIEW SYSTEM (AI-Powered Interview Module)
    // ============================================

    // Interview sessions - users can create/read/update their own sessions
    match /interview_sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Interview questions - authenticated users can read/write questions
    // Questions are session-specific and stored temporarily during interview
    match /interview_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Interview responses - users can write their own responses (cannot modify olqScores/analyzedBy)
    match /interview_responses/{responseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['olqScores', 'analyzedBy']);
    }

    // Webhook logs - server-side backend only (no client access)
    match /webhook_logs/{eventId} {
      allow read, write: if false;
    }

    // Payment records - written only by functions/src/webhooks.js via the
    // Admin SDK (which bypasses these rules entirely). Explicit deny-all
    // here for defense in depth, matching webhook_logs above.
    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // Interview results - users can read their own results
    match /interview_results/{resultId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Question cache - read-only for authenticated clients
    match /question_cache/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Generic questions pool - read-only for users
    // Admins populate this via Firebase Console or admin script
    match /generic_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if false;  // Only admins can write via console
    }

    // Question usage log - append-only telemetry (questionId/sessionId, no
    // userId field to scope ownership to). Clients record usage; nothing
    // reads it back client-side (GitLiveQuestionCacheRepository.getCacheStats
    // aggregates question_cache/generic_questions, not this collection).
    match /question_usage/{usageId} {
      allow read: if false;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ============================================
    // DEFAULT DENY ALL
    // ============================================

    // Deny all other requests by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

