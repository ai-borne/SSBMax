{
  "name": "ssbmax-firestore-setup",
  "version": "1.0.0",
  "description": "Automated Firestore collections setup for SSBMax",
  "main": "setup-firestore.js",
  "scripts": {
    "setup": "node setup-firestore.js",
    "oir:health": "node check-oir-content-health.js",
    "oir:meta:dry-run": "node set-oir-meta-config.js",
    "test:oir": "node test-oir-tooling.js",
    "content:publish": "node content/publishContent.js",
    "content:publish:write": "node content/publishContent.js --write",
    "content:kmp-fallback:generate": "node content/generateKmpFallback.js",
    "content:kmp-fallback:check": "node content/generateKmpFallback.js --check",
    "test:content": "node --test test/content-parser.test.js test/content-document-parser.test.js test/generate-kmp-fallback.drift.test.js test/content-publish.emulator.test.js",
    "test:content:emulator": "firebase emulators:exec --only firestore --project demo-ssbmax --config ../firebase.json \"npm run test:content\"",
    "test:storage": "node --test test/firebase-image-upload.test.js",
    "test:storage:emulator": "firebase emulators:exec --only storage --project demo-ssbmax --config ../firebase.json \"npm run test:storage\""
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "uuid": "^13.0.0"
  },
  "author": "SSBMax Team",
  "license": "MIT",
  "files": [
    "setup-firestore.js",
    "README.md"
  ]
}
