#!/bin/bash
# Git Pre-Commit Hook: Security Checks
# Runs before every commit to catch security violations early.
# Install: git config core.hooksPath scripts/git-hooks
# 
# Checks:
# 1. Hardcoded API keys (GEMINI_API_KEY, sk_*, etc.)
# 2. Sensitive files (local.properties, google-services.json, *.jks, *.key)
# 3. Firestore rules syntax (firebase deploy --dry-run)
# 4. Lint violations (./gradlew lintDebug)

set -e

echo "🔒 Running security pre-commit hooks..."

# 1. Check for hardcoded API keys in staged files (source code only, not docs)
echo "Checking for hardcoded API keys..."
if git diff --cached --name-only | grep -E "\.(kt|java|xml|gradle)$" > /dev/null; then
  KEY_MATCHES=$(git diff --cached -- ':!*.md' ':!scripts/git-hooks/pre-commit' | grep -E "GEMINI_API_KEY\s*=|SARVAM_API_KEY\s*=|ELEVENLABS_API_KEY\s*=|\"sk_|\"sk-|'sk_|'sk-" 2>/dev/null | grep -vE "your_(actual_)?(api_)?key_here" || true)
  if [ -n "$KEY_MATCHES" ]; then
    echo "$KEY_MATCHES"
    echo "❌ ERROR: Hardcoded API key detected in staged files"
    echo "   → Use local.properties or Firebase Remote Config instead"
    exit 1
  fi
fi

# 2. Check for sensitive files (shouldn't be committed)
echo "Checking for sensitive files..."
if git diff --cached --name-only | grep -E "local\.properties|google-services\.json|\.key|\.jks|\.keystore"; then
  echo "❌ ERROR: Sensitive file staged for commit"
  echo "   → Check .gitignore — these files must never be versioned"
  exit 1
fi

# 3. Validate Firestore rules syntax (if rules file is staged)
echo "Validating Firestore rules..."
if git diff --cached --name-only | grep -E "firestore\.rules"; then
  if command -v firebase &> /dev/null; then
    if ! firebase deploy --only firestore:rules --dry-run 2>&1 | grep -q "Validating rules"; then
      echo "❌ ERROR: firestore.rules validation failed"
      echo "   → Run: firebase deploy --only firestore:rules --dry-run"
      exit 1
    fi
  else
    echo "⚠️  WARNING: firebase-tools not installed; skipping rules validation"
    echo "   → Install: npm install -g firebase-tools"
  fi
fi

# 4. Run web platform build & TypeScript checks if web files are staged
if git diff --cached --name-only | grep -E "^web/" > /dev/null; then
  echo "Running Web platform build & TypeScript checks..."
  if ! (cd web && npm run build && npm test -- --run); then
    echo "❌ ERROR: Web platform build or TypeScript check failed"
    echo "   → Run: cd web && npm run build && npm test"
    exit 1
  fi
fi

# 5. Run lint and UI enforcement checks (all modules)
echo "Running lint and UI enforcement checks..."
if ! ./gradlew lintDebug :lint:test :detekt-rules:test :shared:detekt --no-daemon --quiet 2>&1; then
  echo "❌ ERROR: Lint or UI enforcement checks failed"
  echo "   → Fix issues: ./gradlew lintDebug :lint:test :detekt-rules:test :shared:detekt"
  exit 1
fi

echo "✅ All security checks passed"
exit 0
