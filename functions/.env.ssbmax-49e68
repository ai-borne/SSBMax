# Project-scoped Cloud Functions config for ssbmax-49e68 (dev/staging, no real users yet).
# Loaded automatically by the Firebase CLI on deploy/emulate against this project only --
# see https://firebase.google.com/docs/functions/config-env#env-variables.

# Disables the quota gate in eligibility.js::recordAndEnforce and evaluation/core.js::checkQuota
# for dev/QA testing across KMP + web: both still run and still increment
# users/{uid}/subscription/usage_{month} (so recording itself stays verifiable), but neither
# throws once a tier's limit is hit -- they log "[ENFORCE_QUOTA=false] Would have blocked ..."
# instead. This is the existing kill-switch both files already implement
# (`process.env.ENFORCE_QUOTA !== 'false'`); this file is what actually wires it up.
#
# Remove this file (or flip to ENFORCE_QUOTA=true) before this project ever serves real users --
# it removes the real quota gate for everyone who calls these functions while it's set.
ENFORCE_QUOTA=false

# Phase 5 (cost & scale guardrails): scheduledFirestoreBackup.js's daily export target.
# Bucket gs://ssbmax-49e68-firestore-backups created 2026-08-18, asia-south1 (co-located with
# the Firestore database -- required for exportDocuments), uniform bucket-level access +
# public access prevention enforced, 30-day auto-delete lifecycle rule. The App Engine default
# service account (ssbmax-49e68@appspot.gserviceaccount.com, which scheduledFirestoreBackup
# runs as -- it's a 1st-gen function) holds roles/datastore.importExportAdmin (project-level,
# required by the Firestore Admin API export call) and roles/storage.objectAdmin scoped to
# just this bucket.
FIRESTORE_BACKUP_BUCKET=ssbmax-49e68-firestore-backups
