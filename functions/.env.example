# Firebase Functions Environment Variables Template
# Copy this file to .env and fill in your actual values

# Gemini API Key for AI Interview Analysis
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Project Info (auto-populated when deployed)
# GCLOUD_PROJECT=your-project-id

# Quota kill-switch (eligibility.js::recordAndEnforce, evaluation/core.js::checkQuota).
# Default (unset, or any value other than 'false') enforces real per-tier quota limits.
# Set to 'false' only in a project-scoped .env.<project-id> file for a dev/staging project
# with no real users -- it disables blocking for every caller of that project's functions,
# not just yours. Usage is still recorded either way; only the reject-on-over-quota throw
# is skipped (a warning is logged instead).
# ENFORCE_QUOTA=false

# GCS bucket receiving scheduledFirestoreBackup.js's daily export (Phase 5, cost & scale
# guardrails). Bucket must already exist, and the Cloud Functions service account needs the
# "Cloud Datastore Import Export Admin" IAM role -- see the phase's console-steps writeup.
# Backups are skipped (logged, not thrown) when unset, so this is safe to leave empty in dev.
# FIRESTORE_BACKUP_BUCKET=your-project-id-firestore-backups
