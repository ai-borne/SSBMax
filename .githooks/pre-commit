#!/bin/bash
# Pre-commit hook to prevent committing API keys and sensitive data
# This hook is triggered before each commit to validate security

set -e

echo "🔒 Running pre-commit security checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0

# ============================================
# 1. Check for Gemini API keys in staged files
# ============================================
echo ""
echo "🔍 Checking for API keys in staged files..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "$STAGED_FILES" ]; then
    # Check for Gemini API key pattern (AIza followed by 35 chars)
    if echo "$STAGED_FILES" | xargs grep -l "AIza[A-Za-z0-9_-]\{35\}" 2>/dev/null; then
        echo -e "${RED}❌ ERROR: Gemini API key detected in staged files!${NC}"
        echo ""
        echo "Files with API keys:"
        echo "$STAGED_FILES" | xargs grep -n "AIza[A-Za-z0-9_-]\{35\}" 2>/dev/null
        echo ""
        echo "Remove the API key before committing."
        ERRORS=$((ERRORS + 1))
    fi
fi

# ============================================
# 2. Check for sensitive files being added
# ============================================
echo "🔍 Checking for sensitive files..."

SENSITIVE_FILES=(
    "local.properties"
    "functions/.env"
    "functions/.env.local"
    ".env"
    "google-services.json"
    "app/google-services.json"
    "service-account.json"
    "firebase-admin-key.json"
)

for file in "${SENSITIVE_FILES[@]}"; do
    if echo "$STAGED_FILES" | grep -q "^${file}$"; then
        echo -e "${RED}❌ ERROR: Attempting to commit sensitive file: $file${NC}"
        echo "This file should be in .gitignore!"
        ERRORS=$((ERRORS + 1))
    fi
done

# ============================================
# 3. Check for hardcoded secrets in Kotlin/Java code
# ============================================
echo "🔍 Scanning code for hardcoded secrets..."

KOTLIN_JAVA_FILES=$(echo "$STAGED_FILES" | grep -E '\.(kt|java)$' || true)

if [ -n "$KOTLIN_JAVA_FILES" ]; then
    # Pattern 1: apiKey = "AIza..."
    if echo "$KOTLIN_JAVA_FILES" | xargs grep -E 'apiKey\s*=\s*["\x27]AIza' 2>/dev/null; then
        echo -e "${RED}❌ ERROR: Hardcoded API key in Kotlin/Java code${NC}"
        ERRORS=$((ERRORS + 1))
    fi

    # Pattern 2: GEMINI_API_KEY = "AIza..."
    if echo "$KOTLIN_JAVA_FILES" | xargs grep -E 'GEMINI_API_KEY\s*=\s*["\x27]AIza' 2>/dev/null; then
        echo -e "${RED}❌ ERROR: Hardcoded GEMINI_API_KEY in code${NC}"
        ERRORS=$((ERRORS + 1))
    fi

    # Pattern 3: Deprecated functions.config() usage
    if echo "$KOTLIN_JAVA_FILES" | xargs grep -E 'functions\.config\(\)\.gemini' 2>/dev/null; then
        echo -e "${YELLOW}⚠️  WARNING: Using deprecated functions.config()${NC}"
        echo "Consider migrating to .env approach"
    fi
fi

# ============================================
# 4. Check for secrets in JavaScript/TypeScript (Firebase Functions)
# ============================================
JS_TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts)$' | grep -v 'node_modules' || true)

if [ -n "$JS_TS_FILES" ]; then
    # Check for hardcoded API keys in functions
    if echo "$JS_TS_FILES" | xargs grep -E 'apiKey\s*=\s*["\x27]AIza' 2>/dev/null; then
        echo -e "${RED}❌ ERROR: Hardcoded API key in JavaScript/TypeScript${NC}"
        ERRORS=$((ERRORS + 1))
    fi

    # Ensure using process.env.GEMINI_API_KEY, not hardcoded value
    if echo "$JS_TS_FILES" | xargs grep -E 'GEMINI_API_KEY\s*=\s*["\x27]AIza' 2>/dev/null; then
        echo -e "${RED}❌ ERROR: Hardcoded GEMINI_API_KEY in functions code${NC}"
        ERRORS=$((ERRORS + 1))
    fi
fi

# ============================================
# 5. Check for secrets in XML/JSON config files
# ============================================
CONFIG_FILES=$(echo "$STAGED_FILES" | grep -E '\.(xml|json)$' | grep -v 'node_modules' || true)

if [ -n "$CONFIG_FILES" ]; then
    if echo "$CONFIG_FILES" | xargs grep -i "AIza[A-Za-z0-9_-]\{35\}" 2>/dev/null; then
        echo -e "${RED}❌ ERROR: API key found in config files${NC}"
        ERRORS=$((ERRORS + 1))
    fi
fi

# ============================================
# 6. Check for *Holder.kt anti-pattern files
# ============================================
echo "🔍 Checking for anti-pattern files..."

HOLDER_FILES=$(echo "$STAGED_FILES" | grep -E 'Holder\.kt$' || true)

if [ -n "$HOLDER_FILES" ]; then
    echo -e "${RED}❌ ERROR: *Holder.kt files are forbidden (anti-pattern)${NC}"
    echo "Found: $HOLDER_FILES"
    echo ""
    echo "Use ViewModel for UI state or Repository for data management."
    ERRORS=$((ERRORS + 1))
fi

# ============================================
# 7. Module-Aware Checks (from CLAUDE.md guidelines)
# ============================================
echo "🔍 Running module-specific architecture checks..."

# Check 7a: core:domain has no Android dependencies
echo "  → Checking core:domain has no Android imports..."
DOMAIN_FILES=$(echo "$KOTLIN_JAVA_FILES" | grep 'core/domain' || true)

if [ -n "$DOMAIN_FILES" ]; then
    if echo "$DOMAIN_FILES" | xargs grep -E '^import (android\.|androidx\.)' 2>/dev/null; then
        echo -e "${RED}❌ ERROR: Android imports found in core:domain${NC}"
        echo "core:domain must be 100% pure Kotlin (no Android dependencies)"
        ERRORS=$((ERRORS + 1))
    fi
fi

# Check 7b: app layer doesn't import Firebase (except Firebase Auth)
echo "  → Checking app layer avoids Firebase imports..."
APP_FILES=$(echo "$KOTLIN_JAVA_FILES" | grep 'app/src' | grep -v 'firebase.auth' || true)

if [ -n "$APP_FILES" ]; then
    if echo "$APP_FILES" | xargs grep -E '^import com\.(google\.firebase|firebase)\.' 2>/dev/null | grep -v 'firebase\.auth'; then
        echo -e "${RED}❌ ERROR: Firebase imports in app layer (except Firebase Auth)${NC}"
        echo "Use repositories from shared instead (core:data was deleted, KMP-convergence Phase 9f)"
        ERRORS=$((ERRORS + 1))
    fi
fi

# Check 7c: designsystem Composables should have @Preview
echo "  → Checking designsystem Composables have @Preview..."
DESIGNSYSTEM_COMPOSABLES=$(echo "$KOTLIN_JAVA_FILES" | grep 'designsystem/src' || true)

if [ -n "$DESIGNSYSTEM_COMPOSABLES" ]; then
    # Simple heuristic: if file contains @Composable and not in test, check for @Preview
    for file in $DESIGNSYSTEM_COMPOSABLES; do
        if grep -q '@Composable' "$file" && ! echo "$file" | grep -q 'Test'; then
            if ! grep -q '@Preview' "$file"; then
                echo -e "${YELLOW}⚠️  WARNING: Composable in designsystem should have @Preview: $file${NC}"
            fi
        fi
    done
fi

# ============================================
# 8. Run UI enforcement tests for changed UI/rule files
# ============================================
echo "🔍 Running UI enforcement regression tests when needed..."

UI_OR_RULE_FILES=$(echo "$STAGED_FILES" | grep -E '(^shared/src/.*/(ui|commonMain)|^app/src/.*(ui|MainActivity)|^detekt-rules/|^lint/|^config/detekt/)' || true)
if [ -n "$UI_OR_RULE_FILES" ]; then
    ./gradlew :lint:test :detekt-rules:test :shared:detekt --no-daemon --quiet
fi

# ============================================
# 8b. Run Web Platform Build & TypeScript Checks
# ============================================
WEB_FILES=$(echo "$STAGED_FILES" | grep -E '^web/' || true)
if [ -n "$WEB_FILES" ]; then
    echo "🔍 Running Web platform build & TypeScript checks..."
    if ! (cd web && npm run build && npm test -- --run); then
        echo -e "${RED}❌ ERROR: Web platform build or TypeScript check failed!${NC}"
        echo "   → Run locally: cd web && npm run build && npm test"
        ERRORS=$((ERRORS + 1))
    fi
fi

# ============================================
# 9. Validate commit message doesn't contain secrets
# ============================================
echo "🔍 Checking commit message (if available)..."

# Note: Commit message is not yet available in pre-commit hook
# This check is done in commit-msg hook instead

# ============================================
# Final result
# ============================================
echo ""

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}============================================${NC}"
    echo -e "${RED}❌  Pre-commit checks FAILED with $ERRORS error(s)${NC}"
    echo -e "${RED}============================================${NC}"
    echo ""
    echo "Fix the issues above before committing."
    echo ""
    echo "To bypass this hook (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
else
    echo -e "${GREEN}============================================${NC}"
    echo -e "${GREEN}✅  All pre-commit checks passed!${NC}"
    echo -e "${GREEN}============================================${NC}"
    echo ""
    exit 0
fi
