{
  "name": "ssbmax-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate:content && npm run generate:faq && npm run generate:seo",
    "dev": "vite",
    "prebuild": "npm run content:validate && npm run generate:content && npm run generate:faq && npm run generate:seo",
    "build": "tsc -b && vite build && node scripts/prerenderContentRoutes.mjs && node scripts/write-version.mjs",
    "preview": "vite preview",
    "pretest": "npm run generate:content && npm run generate:faq && npm run generate:seo",
    "test": "vitest run --exclude '**/sharedCorpusEmulator.test.ts' --exclude '**/tests/e2e/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:corpus": "vitest run tests/unit/contracts/sharedCorpusEmulator.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "content:validate": "node scripts/validate-content.mjs",
    "generate:content": "node scripts/generateContentBundle.mjs",
    "generate:faq": "node scripts/generateFaqBundle.mjs",
    "generate:seo": "node scripts/generateSeoFiles.mjs"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.124.0"
  }
}
