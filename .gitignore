# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/
.kotlin/

# Xcode user-specific state (KMP iosApp/) -- xcshareddata/swiftpm/Package.resolved
# is intentionally NOT ignored: it pins the resolved firebase-ios-sdk SPM version.
iosApp/iosApp.xcodeproj/xcuserdata/
iosApp/iosApp.xcodeproj/project.xcworkspace/xcuserdata/

# Local configuration file (sdk path, etc)
local.properties

# Local Gradle configuration overrides
gradle.properties.local
gradle.local.properties

# Environment variables (contains API keys and secrets)
.env
.env.local
.env.*.local
.env.production
.env.*.production
*.env
*.env.production

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ (all IDE configuration)
*.iml
.idea/

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json
.firebase/

# Firebase Service Account (CRITICAL - Contains Admin Private Keys)
**/service-account.json
service-account*.json
firebase-admin-key.json
**/firebase-admin-key.json

# Additional sensitive files
**/google-services.json
app/google-services.json
core/**/google-services.json

# iOS Firebase config (KMP migration Phase 6) -- same "real secret, never
# committed" treatment as google-services.json above. The checked-in
# GoogleService-Info.plist.example is a placeholder template, not this.
iosApp/iosApp/GoogleService-Info.plist

# iOS build secrets (GEMINI_API_KEY etc, via Xcode baseConfigurationReference)
# -- same treatment, real file never committed. Secrets.xcconfig.example is
# the checked-in placeholder template.
iosApp/iosApp/Secrets.xcconfig

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/
# lint-baseline.xml is intentionally tracked — required for CI lint to pass

# Android Profiling
*.hprof

# MacOS
.DS_Store

# Backup files
*.bak
*~

# Cursor AI
.cursor/

# Node.js dependencies (contains test data with hardcoded passwords)
node_modules/
scripts/node_modules/
web/node_modules/
web/dist/
web/dev-dist/
web/test-results/
web/playwright-report/
*.tsbuildinfo

# ============================================
# DOCUMENTATION FILES
# ============================================
# All documentation should live in /docs/ directory
# Prevent auto-generated MD files in root
*.md
!README.md
!CHANGELOG.md
!claude.md
!CLAUDE_HIERARCHY.md
!GUIDELINES.md
!**/CLAUDE.md
!docs/**/*.md

# Temporary/Debug Documentation (may contain sensitive data during cleanup)
*CLEANUP*.md
*DEBUG*.md
*TEMP*.md
*SENSITIVE*.md

# Build and status reports
*BUILD*.md
*SUCCESS*.md
*COMPLETE*.md
*SUMMARY*.md
*REPORT*.md
*STATUS*.md
*PROGRESS*.md
*FIX*.md
*ERROR*.md

# ============================================
# FIREBASE RULES BACKUPS
# ============================================
# Only track the main firestore.rules file
firestore.rules.CORRECT
firestore.rules.updated
firestore.rules.backup*
firestore.rules.old*
# PR and CI files
PR_SUMMARY.md
ci_check.sh

# ============================================
# COCOAPODS (Kotlin/Native linking only)
# ============================================
# shared/build.gradle.kts's `cocoapods {}` block regenerates this on every
# build (Firebase pod versions can shift); nothing outside Gradle reads it,
# unlike a podspec meant for external Xcode/Podfile consumption.
/shared/*.podspec

# Wrangler
.wrangler/

